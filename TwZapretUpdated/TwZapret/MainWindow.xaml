<Window x:Class="TwZapret.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TwZapret" Height="550" Width="850" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanMinimize">

    <Window.Resources>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Background" Value="#2b2d31"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5865F2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowBtn" TargetType="Button">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#44FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" ClipToBounds="True">
        <Grid x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0b0c10" Offset="0.0"/>
                    <GradientStop Color="#1f2833" Offset="0.5"/>
                    <GradientStop Color="#450a5c" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="TwZapret" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Style="{StaticResource WindowBtn}" Click="MinimizeBtn_Click"/>
                    <Button Content="✕" Click="CloseBtn_Click">
    <Button.Style>
        <Style TargetType="Button" BasedOn="{StaticResource WindowBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Button.Style>
</Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Grid.Column="0" Background="#111214" CornerRadius="0,15,0,0">
                <StackPanel Margin="0,15,0,0">
                    <Border Background="#5865F2" Width="40" Height="40" CornerRadius="10" Margin="0,0,0,20">
                        <TextBlock Text="TW" Foreground="White" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <Button x:Name="Tab1Btn" Content="1" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="1"/>
                    <Button x:Name="Tab2Btn" Content="2" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="2"/>
                    <Button x:Name="Tab3Btn" Content="3" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="3"/>
                    <Button x:Name="Tab4Btn" Content="4" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="4"/>
                    <Button x:Name="Tab5Btn" Content="5" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="5"/>
                    <Button x:Name="Tab6Btn" Content="⚙" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="6" Margin="0,30,0,0"/>
                </StackPanel>
            </Border>

            <Grid x:Name="Tab1_Main" Grid.Row="1" Grid.Column="1" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="MainTitle" Text="Zapret" FontSize="48" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="FileNameText" Text="(файл не выбран)" Foreground="#A0A0A0" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Button x:Name="ToggleBtn" Content="ВКЛЮЧИТЬ" Width="200" Height="60" Background="#23a559" Foreground="White" Click="ToggleBtn_Click" Cursor="Hand" FontWeight="Bold" FontSize="20">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                    </Button>
                    <TextBlock x:Name="FilePathText" Text="Зайдите в папку на вкладке 5" Foreground="Gray" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
                <TextBlock Text="Версия № 0.6.0" Foreground="#555" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10"/>
            </Grid>

            <Grid x:Name="Tab2_VPN" Grid.Row="1" Grid.Column="1" Visibility="Hidden" Margin="30">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
                    <TextBlock Text="Свой VPN" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,0,0,30" HorizontalAlignment="Center"/>
                    <TextBlock Text="IP-адрес сервера:" Foreground="#A0A0A0" Margin="0,0,0,5"/>
                    <TextBox Height="35" Background="#1e1f22" Foreground="White" BorderBrush="#5865F2" Padding="5" Margin="0,0,0,15"/>
                    <TextBlock Text="Порт:" Foreground="#A0A0A0" Margin="0,0,0,5"/>
                    <TextBox Height="35" Background="#1e1f22" Foreground="White" BorderBrush="#5865F2" Padding="5" Margin="0,0,0,15"/>
                    <TextBlock Text="Ключ доступа / Токен:" Foreground="#A0A0A0" Margin="0,0,0,5"/>
                    <TextBox Height="35" Background="#1e1f22" Foreground="White" BorderBrush="#5865F2" Padding="5" Margin="0,0,0,25"/>
                    <Button Content="ПОДКЛЮЧИТЬ" Height="50" Background="#5865F2" Foreground="White" Cursor="Hand" FontWeight="Bold" FontSize="16">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="Tab3_Ping" Grid.Row="1" Grid.Column="1" Visibility="Hidden" Margin="30">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Сетевой тестер" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15" HorizontalAlignment="Center">
                        <ComboBox x:Name="PingPresetCombo" Width="150" Height="35" Margin="0,0,10,0" SelectionChanged="PingPresetCombo_SelectionChanged">
                            <ComboBoxItem Content="Свой адрес" IsSelected="True"/>
                            <ComboBoxItem Content="Google (8.8.8.8)"/>
                            <ComboBoxItem Content="Cloudflare (1.1.1.1)"/>
                            <ComboBoxItem Content="YouTube"/>
                            <ComboBoxItem Content="Discord"/>
                            <ComboBoxItem Content="Steam"/>
                        </ComboBox>
                        <TextBox x:Name="PingAddressInput" Text="google.com" Width="200" Height="35" Background="#1e1f22" Foreground="White" BorderBrush="#5865F2" Padding="5" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20" HorizontalAlignment="Center">
                        <Button x:Name="PingBtn" Content="PING" Width="100" Height="35" Margin="0,0,10,0" Background="#5865F2" Foreground="White" Cursor="Hand" FontWeight="Bold" Click="PingBtn_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                        </Button>
                        <Button Content="Сброс DNS" Width="100" Height="35" Margin="0,0,10,0" Background="#da373c" Foreground="White" Cursor="Hand" FontWeight="Bold" Click="FlushDnsBtn_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                        </Button>
                        <Button Content="Xbox DNS" Width="100" Height="35" Background="#23a559" Foreground="White" Cursor="Hand" FontWeight="Bold" Click="XboxDnsBtn_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>

                    <Border Background="#111214" CornerRadius="10" Width="360" Height="150" Padding="15">
                        <TextBlock x:Name="PingResultText" Text="Ожидание..." Foreground="#A0A0A0" FontSize="14" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="Tab4_Monitor" Grid.Row="1" Grid.Column="1" Visibility="Hidden" Margin="30">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Мониторинг ПК" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,0,0,30" HorizontalAlignment="Center"/>
                    <Grid Width="400">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Border Grid.Row="0" Background="#1e1f22" CornerRadius="10" Margin="0,0,0,15" Padding="20">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CPU (Процессор)" Foreground="#A0A0A0" FontSize="16"/>
                                    <TextBlock Grid.Column="1" x:Name="CpuText" Text="0 %" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                </Grid>
                                <ProgressBar x:Name="CpuProgress" Height="10" Margin="0,10,0,0" Maximum="100" Value="0" Background="#111214" Foreground="#5865F2" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="#1e1f22" CornerRadius="10" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Свободная RAM" Foreground="#A0A0A0" FontSize="16"/>
                                <TextBlock Grid.Column="1" x:Name="RamText" Text="0 MB" Foreground="White" FontSize="16" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid x:Name="Tab5_Hub" Grid.Row="1" Grid.Column="1" Visibility="Hidden" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Скрипты Zapret" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                    <TextBlock Text="Файлы загружены из встроенной папки" Foreground="#A0A0A0" Margin="0,0,0,20"/>
                </StackPanel>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FilesListPanel"/>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="Tab6_Settings" Grid.Row="1" Grid.Column="1" Visibility="Hidden" Margin="30">
                <StackPanel>
                    <TextBlock Text="Настройки" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

                    <StackPanel Margin="0,0,0,20">
                        <CheckBox x:Name="AutoStartCheck" Content="Запускать вместе с Windows" Foreground="White" Margin="0,0,0,10" Click="SettingsCheck_Changed"/>
                        <CheckBox x:Name="MinimizeTrayCheck" Content="Сворачивать в трей вместо закрытия" Foreground="White" Click="SettingsCheck_Changed"/>
                    </StackPanel>

                    <TextBlock Text="Статус в Discord:" Foreground="#A0A0A0" Margin="0,0,0,5"/>
                    <ComboBox x:Name="DiscordCombo" Width="300" Height="30" HorizontalAlignment="Left" Margin="0,0,0,20" SelectionChanged="DiscordCombo_SelectionChanged">
                        <ComboBoxItem Content="TwZapret Launcher (По умолчанию)" IsSelected="True"/>
                        <ComboBoxItem Content="Обход DPI: Активен"/>
                        <ComboBoxItem Content="В сети (Скрытый режим)"/>
                        <ComboBoxItem Content="Играю в Rust"/>
                        <ComboBoxItem Content="TW: Разработка"/>
                    </ComboBox>

                    <TextBlock Text="Горячая клавиша (ВКЛ/ВЫКЛ):" Foreground="#A0A0A0" Margin="0,0,0,5"/>
                    <ComboBox x:Name="HotkeyCombo" Width="300" Height="30" HorizontalAlignment="Left" Margin="0,0,0,20" SelectionChanged="HotkeyCombo_SelectionChanged">
                        <ComboBoxItem Content="Ctrl + Shift + Z" IsSelected="True"/>
                        <ComboBoxItem Content="Ctrl + Shift + X"/>
                        <ComboBoxItem Content="Alt + Z"/>
                        <ComboBoxItem Content="F9"/>
                    </ComboBox>

                    <TextBlock Text="Тема оформления:" Foreground="#A0A0A0" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ThemeCombo" Width="300" Height="30" HorizontalAlignment="Left" SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="LiquidGlass (Стандарт)" IsSelected="True"/>
                        <ComboBoxItem Content="Темная (Dark)"/>
                        <ComboBoxItem Content="Тёмно-зеленая"/>
                        <ComboBoxItem Content="Фиолетовая"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>